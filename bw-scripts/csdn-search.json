            "js_code": "(() => {\n  const articles = [];\n\ndocument.querySelectorAll('.list-container .list-item').forEach(item => {\n  // \u8df3\u8fc7\"\u5feb\u901f\u63d0\u95ee\"\u7b49\u975e\u6587\u7ae0\u9879\n  const linkEl = item.querySelector('.item-hd h3.title a');\n  if (!linkEl) return;\n\n  // \u6807\u9898\uff08\u53bb\u6389 <em> \u6807\u7b7e\u540e\u7684\u7eaf\u6587\u672c\uff09\n  const title = linkEl.textContent.trim();\n\n  // \u94fe\u63a5\n  const link = linkEl.href;\n\n  // \u521b\u5efa\u65f6\u95f4\n  const timeEl = item.querySelector('.btm-rt .time');\n  const createTime = timeEl ? timeEl.textContent.trim() : '';\n\n  // \u5185\u5bb9\u6458\u8981\n  const contentEl = item.querySelector('.item-bd__cont .bdc-lt p.row2');\n  const content = contentEl ? contentEl.textContent.trim() : '';\n\n  articles.push({ title, link, createTime, content });\n});\n\n  \n  return articles;\n})()"
